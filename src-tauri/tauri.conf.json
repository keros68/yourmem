{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yourmem",
  "version": "1.2.0",
  "identifier": "com.yourmem.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "yourmem",
        "width": 1220,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Developer Tools",
    "copyright": "Copyright © 2026 yourmem contributors",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFOUQ2NkQ2OUY5OUZCOUQKUldTZCs1bWYxbWFkWHJ2QUdoaGoxT3h0MGE4Q0ppMkI4SEVDNi9udDRVakZrZWFVUGFScms5aU4K",
      "endpoints": [
        "https://github.com/keros68/yourmem/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
