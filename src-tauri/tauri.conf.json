{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yourmem",
  "version": "1.1.5",
  "identifier": "com.yourmem.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "yourmem",
        "width": 1220,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Developer Tools",
    "copyright": "Copyright © 2026 yourmem contributors",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
